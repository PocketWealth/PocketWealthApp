<div class="card bg-base-200 w-96 shadow-xl">
  <div class="card-body">
    <h2 class="card-title"><%= api_key.provider %></h2>
    <p><strong>Access Token:</strong> <%= api_key.access_token %></p>
    <p><strong>Refresh Token:</strong> <%= api_key.refresh_token %>$</p>
    <div class="card-actions justify-end">
      <%= link_to "View API Key", api_key_path(api_key.id), class: "btn btn-primary" %>
    </div>
  </div>
</div>