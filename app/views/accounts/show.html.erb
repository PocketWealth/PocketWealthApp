<div class="flex flex-row">
  <div>
    <%= render "layouts/sidenav" %>
  </div>

  <% content_for :title, "Account" %>

  <div>
    <div>
      <h1 class="text-4xl font-bold ml-5">Account <%= @account.name %></h1>
    </div>
    <div class="ml-5">
      <% if notice.present? %>
        <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
      <% end %>
      <div>
        <h1>Stocks</h1>
        <%= render "stocks/stock_table", :stocks => @account.stocks %>
      </div>


      <div>
        <h1>Transactions</h1>
      </div>

      <div class="stats shadow">
        <div class="stat">
          <div class="stat-title">Cash</div>
          <div class="stat-value"><%= @account.cash %></div>
        </div>
      </div>

      <div class="mt-5">
        <%= link_to "Edit this account", edit_account_path(@account), class: "btn btn-primary" %>
        <%= link_to "Add Cash", account_edit_cash_path(@account, :edit_type => "add"), class: "btn btn-primary" %>
        <%= link_to "Remove Cash", account_edit_cash_path(@account, :edit_type => "remove"), class: "btn btn-primary" %>
        <%= link_to "Transfer Cash", account_edit_cash_path(@account, :edit_type => "transfer"), class: "btn btn-primary" %>
        <div class="inline-block ml-2">
          <%= button_to "Delete this account", @account, method: :delete, class: "btn btn-warning" %>
        </div>
      </div>
    </div>

  </div>
</div>