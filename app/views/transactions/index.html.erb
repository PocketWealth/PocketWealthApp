<div class="flex flex-row">
  <div>
    <%= render "layouts/sidenav" %>
  </div>

  <% content_for :title, "Transactions" %>

  <div class="flex flex-col mr-5 max-w-screen-lg basis-full">
    <div>
      <h1 class="text-4xl font-bold ml-5 mb-5">Transactions</h1>
      <% if notice.present? %>
        <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block ml-5" id="notice"><%= notice %></p>
      <% end %>
    </div>

    <div class="flex flex-col">
      <%= render "transaction_table" %>
      <%= link_to "Add Transaction", new_transaction_path, class: "btn btn-primary self-end" %>
    </div>
  </div>
</div>
