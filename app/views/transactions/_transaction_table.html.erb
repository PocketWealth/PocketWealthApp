<div class="overflow-x-auto mb-5">
  <table class="table table-xs table-pin-rows table-pin-cols">
    <thead>
    <tr>
      <th></th>
      <td>Transaction Type</td>
      <td>Funds Value Added</td>
      <td>Funds Value Removed</td>
      <td>Funds Value Transferred</td>
      <td>Stock Symbol</td>
      <td>Stock Quantity</td>
      <td>Stock Value Added</td>
      <td>Stock Value Removed</td>
      <td>Stock Value Transferred</td>
      <td>From Account ID</td>
      <td>To Account ID</td>
      <td>Created At</td>
      <th></th>
    </tr>
    </thead>
    <tbody>
    <% @transactions.each do |transaction| %>
      <%= link_to transactions_path do %>
        <%= render "transactions/transaction_row", transaction: transaction %>
      <% end %>
    <% end %>
    </tbody>
  </table>
</div>