<div class="flex flex-row">
  <div>
    <%= render "layouts/sidenav" %>
  </div>

  <% content_for :title, "Transaction" %>

  <div>
    <div>
      <% if notice.present? %>
        <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block ml-5" id="notice"><%= notice %></p>
      <% end %>
    </div>
    <div class="ml-5">
      <%= render @transaction %>

      <div class="mt-5">
        <%= link_to "Edit this transaction", edit_transaction_path(@transaction), class: "btn btn-primary" %>
        <div class="inline-block ml-2">
          <%= button_to "Delete this transaction", @transaction, method: :delete, class: "btn btn-warning" %>
        </div>
      </div>

    </div>

  </div>
</div>